{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0",
      "maxDuration": 10
    }
  },
  "crons": [
    {
      "path": "/api/telegram-report.php",
      "schedule": "30 6 * * 1"
    },
    {
      "path": "/api/telegram-alerts.php",
      "schedule": "0 8 * * *"
    }
  ]
}
